.canvas-wrapper {
  position: relative;
  width: calc(100vw - 32px);
  height: 50vh;
  background: #f8f8f8;
  border-radius: var(--ios-radius);
  overflow: hidden;
  margin: 0 16px 12px;
}
.three-canvas { width: 100%; height: 100%; }
.canvas-hint {
  position: absolute;
  bottom: 12px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.45);
  color: #fff;
  font-size: 12px;
  padding: 5px 14px;
  border-radius: 20px;
  white-space: nowrap;
}

.control-bar {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-bottom: 12px;
}
.ctrl-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  background: #fff;
  border-radius: var(--ios-radius);
  padding: 10px 20px;
  min-width: 70px;
  -webkit-tap-highlight-color: transparent;
}
.ctrl-icon { font-size: 22px; }
.ctrl-label { font-size: 11px; color: #8e8e93; font-weight: 500; }

.room-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 10px;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 4px 0;
}
.detail-label {
  font-size: 15px;
  color: #8e8e93;
  flex-shrink: 0;
  width: 50px;
}
.detail-value { font-size: 15px; color: #000; font-weight: 500; }
.detail-tags { flex: 1; display: flex; flex-wrap: wrap; gap: 6px; }
.detail-tag {
  font-size: 12px;
  background: rgba(0,122,255,0.1);
  color: var(--ios-blue);
  padding: 3px 10px;
  border-radius: 12px;
}
