.ios-seg-item-group {
  display: flex;
  gap: 6px;
}
.ios-seg-pill {
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 500;
  background: rgba(118,118,128,0.12);
  color: #8e8e93;
  -webkit-tap-highlight-color: transparent;
}
.ios-seg-pill.active {
  background: var(--ios-blue);
  color: #fff;
}

.layer-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.layer-toggle {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 20px;
  background: rgba(118,118,128,0.12);
  font-size: 13px;
  color: #8e8e93;
  font-weight: 500;
  -webkit-tap-highlight-color: transparent;
  transition: all 0.2s;
}
.layer-toggle.on {
  background: rgba(0,122,255,0.1);
  color: var(--ios-blue);
}
.layer-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.canvas-wrapper {
  width: calc(100vw - 32px);
  height: 45vh;
  background: #fff;
  border-radius: var(--ios-radius);
  overflow: hidden;
  margin: 0 16px 12px;
  border: 0.5px solid #e5e5ea;
}
.layout-canvas {
  width: 100%;
  height: 100%;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 5px 0;
}
.tip-bullet { font-size: 16px; flex-shrink: 0; margin-top: 1px; }
.tip-text { font-size: 14px; color: #3c3c43; line-height: 1.5; flex: 1; }
