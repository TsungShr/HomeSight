/* ===== 家具编辑页 ===== */

/* 拖放幽灵 */
.drag-ghost {
  position: fixed;
  transform: translate(-50%, -50%) scale(1.1);
  opacity: 0.85;
  pointer-events: none;
  z-index: 9999;
  background: rgba(0,122,255,0.1);
  border: 1.5px solid rgba(0,122,255,0.4);
  border-radius: 8px;
  padding: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.1s;
}

/* Header */
.edit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 18px 8px;
}
.header-actions {
  display: flex;
  gap: 8px;
}
.ios-icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  background: rgba(0,122,255,0.10);
  border-radius: 50%;
  -webkit-tap-highlight-color: transparent;
}
.ios-icon-btn:active { opacity: 0.7; }
.ios-icon-btn-add {
  background: var(--ios-blue);
}
.ios-icon-btn-add image {
  filter: brightness(0) invert(1);
}

/* 房间标签栏 */
.page-scroll {
  position: fixed;
  top: 88px;
  left: 0;
  right: 0;
  bottom: 0;
  height: auto;
}

.room-scroll {
  padding: 0 16px;
  margin-bottom: 12px;
}
.room-chips {
  display: inline-flex;
  gap: 8px;
  padding: 4px 0;
}
.room-chip {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8px 12px;
  background: #fff;
  border-radius: var(--ios-radius);
  font-size: 13px;
  font-weight: 500;
  color: #000;
  gap: 3px;
  white-space: nowrap;
  -webkit-tap-highlight-color: transparent;
  border: 0.5px solid rgba(0,0,0,0.08);
  min-width: 52px;
}
.room-chip.active {
  color: #fff;
  border-color: transparent;
}
.chip-top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chip-delete {
  position: absolute;
  top: -8px;
  right: -10px;
  width: 18px;
  height: 18px;
  background: rgba(0,0,0,0.35);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-tap-highlight-color: transparent;
}
.chip-delete:active { background: rgba(255,59,48,0.7); }
.chip-delete image { filter: brightness(0) invert(1); }
.chip-name {
  font-size: 11px;
  color: inherit;
  font-weight: 600;
}
.chip-area {
  font-size: 10px;
  opacity: 0.72;
}
.room-chip-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 8px 16px;
  color: #888;
  -webkit-tap-highlight-color: transparent;
}

/* 画布 */
.canvas-wrapper {
  position: relative;
  height: 300px;
  background: #fff;
  border-radius: var(--ios-radius);
  overflow: hidden;
  margin: 0 16px 12px;
  border: 0.5px solid rgba(0,0,0,0.1);
  touch-action: none;
}
.editor-canvas {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}
.furniture-layer {
  position: absolute;
  top: 0; left: 0;
}
.furniture-item {
  position: absolute;
  background: rgba(0,122,255,0.06);
  border: 1.5px solid rgba(0,122,255,0.25);
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  box-sizing: border-box;
  pointer-events: auto;
  -webkit-tap-highlight-color: transparent;
}
.furniture-item.selected {
  border-color: var(--ios-blue);
  border-width: 2px;
  background: rgba(0,122,255,0.10);
  box-shadow: 0 0 0 3px rgba(0,122,255,0.15);
  z-index: 10;
}
.furniture-name {
  font-size: 10px;
  color: rgba(0,122,255,0.8);
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 2px;
}

/* 选中家具操作条 */
.furniture-actions-bar {
  position: absolute;
  bottom: 10px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 4px;
  background: rgba(255,255,255,0.95);
  border-radius: 20px;
  padding: 6px 8px;
  border: 0.5px solid rgba(0,0,0,0.08);
  backdrop-filter: blur(8px);
  box-shadow: 0 2px 12px rgba(0,0,0,0.10);
}
.fabtn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 4px 10px;
  border-radius: 12px;
  -webkit-tap-highlight-color: rgba(0,0,0,0.06);
}
.fabtn:active { background: rgba(0,0,0,0.06); }
.fabtn text {
  font-size: 10px;
  color: #333;
}
.fabtn-danger text { color: #ff3b30; }

/* 家具网格 */
.ios-card {
  background: var(--ios-card);
  border-radius: var(--ios-radius);
  overflow: hidden;
  margin: 0 16px 12px;
}
.furniture-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.5px;
  background: rgba(0,0,0,0.06);
}
.furniture-grid .furniture-card {
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14px 4px;
  gap: 6px;
  -webkit-tap-highlight-color: rgba(0,0,0,0.04);
}
.furniture-grid .furniture-card:active {
  background: rgba(0,0,0,0.04);
}
.fc-name {
  font-size: 11px;
  color: var(--ios-text-3);
  text-align: center;
  line-height: 1.3;
}

/* 底部操作 */
.ios-bottom {
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  background: #f2f2f7;
}
.ios-btn-group {
  display: flex;
  gap: 10px;
  width: 100%;
  align-items: center;
}
.ios-btn-group .ios-btn { flex: 1; min-width: 0; }

/* 危险按钮 */
.ios-btn-danger {
  background: #fff;
  color: #ff3b30;
  border: 0.5px solid rgba(255,59,48,0.3);
  border-radius: 10px;
  font-size: 17px;
  font-weight: 600;
  padding: 14px 20px;
  line-height: 1.2;
}
.ios-btn-danger:active { background: rgba(255,59,48,0.06); }

/* 底部弹层 */
.model-sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0);
  z-index: 999;
  pointer-events: none;
  transition: background 0.25s;
}
.model-sheet-mask.mask-show {
  background: rgba(0,0,0,0.45);
  pointer-events: auto;
}
.model-sheet {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  z-index: 1000;
  background: var(--ios-card);
  border-radius: 16px 16px 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}
.model-sheet.sheet-show { transform: translateY(0); }
.sheet-handle {
  width: 36px;
  height: 5px;
  background: rgba(118,118,128,0.3);
  border-radius: 3px;
  margin: 10px auto 0;
}
.sheet-header {
  text-align: center;
  font-size: 15px;
  font-weight: 600;
  color: var(--ios-text);
  padding: 16px 0 10px;
  border-bottom: 0.5px solid var(--ios-sep);
  margin: 0 16px;
}
.sheet-list {
  padding: 8px 0;
  max-height: 360px;
  overflow-y: auto;
}
.sheet-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 20px;
  -webkit-tap-highlight-color: rgba(0,0,0,0.04);
}
.sheet-item:active { background: rgba(0,0,0,0.04); }
.sheet-item-dot {
  width: 10px; height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}
.sheet-item-name { font-size: 15px; color: var(--ios-text); }
.sheet-cancel {
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  color: #007AFF;
  padding: 16px 0;
  border-top: 8px solid rgba(118,118,128,0.12);
}
.sheet-cancel:active { background: rgba(0,0,0,0.04); }

/* 编辑房间表单 */
.edit-room-form {
  padding: 16px 20px 8px;
}
.form-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 0.5px solid rgba(0,0,0,0.06);
}
.form-label {
  font-size: 15px;
  color: var(--ios-text-3);
  width: 70px;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 15px;
  color: var(--ios-text);
  background: transparent;
  border: none;
  outline: none;
}
