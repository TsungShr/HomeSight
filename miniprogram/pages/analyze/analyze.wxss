.overview-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 8px 0;
}
.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  flex: 1;
}
.overview-value {
  font-size: 28px;
  font-weight: 700;
  color: var(--ios-blue);
}
.overview-label {
  font-size: 11px;
  color: #8e8e93;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}
.overview-divider {
  width: 0.5px;
  height: 40px;
  background: var(--ios-sep);
}

.floorplan-img {
  width: 100%;
  display: block;
  background: #f2f2f7;
}

.room-cell {
  display: flex;
  align-items: flex-start;
  padding: 14px 16px;
  border-bottom: 0.5px solid var(--ios-sep);
  gap: 14px;
}
.room-cell:last-child { border-bottom: none; }
.room-color-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--room-color, #007aff);
  flex-shrink: 0;
  margin-top: 5px;
}
.room-info { flex: 1; }
.room-top {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 6px;
}
.room-name {
  font-size: 17px;
  font-weight: 600;
  color: #000;
  flex: 1;
}
.room-features { display: flex; flex-wrap: wrap; gap: 4px; }
.room-feature {
  font-size: 12px;
  color: #8e8e93;
}
.room-feature::before { content: '· '; }

.pro-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 6px 0;
}
.pro-check { color: var(--ios-green); font-size: 16px; font-weight: 700; flex-shrink: 0; margin-top: 1px; }
.pro-text { font-size: 15px; color: var(--ios-text-2); line-height: 1.5; }

.caution-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 6px 0;
}
.caution-icon {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--ios-orange);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2px;
}
.caution-text { font-size: 15px; color: var(--ios-text-2); line-height: 1.5; }

.advice-text {
  font-size: 15px;
  color: var(--ios-text-2);
  line-height: 1.7;
  white-space: pre-wrap;
}

.ios-spinner {
  border: 3px solid rgba(0, 122, 255, 0.15);
  border-top-color: var(--ios-blue);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
