/* ===== 首页上传区域 ===== */
.upload-zone {
  padding: 40px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  min-height: 180px;
  justify-content: center;
  border-bottom: 0.5px solid var(--ios-sep);
}

.upload-zone.has-img {
  padding: 0;
  min-height: 200px;
}

.upload-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.upload-icon-img {
  width: 72px;
  height: 72px;
}

.upload-title {
  font-size: 17px;
  font-weight: 600;
  color: var(--ios-text);
}

.upload-hint {
  font-size: 13px;
  color: var(--ios-text-3);
}

.upload-tags {
  display: flex;
  gap: 8px;
}

.upload-tag {
  font-size: 11px;
  color: var(--ios-text-3);
  background: rgba(118,118,128,0.12);
  padding: 4px 10px;
  border-radius: 12px;
}

.upload-preview {
  width: 100%;
  height: 200px;
}

.upload-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 10px 16px;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-overlay-text {
  font-size: 13px;
  color: rgba(255,255,255,0.85);
}

.history-thumb {
  width: 44px;
  height: 44px;
  border-radius: 6px;
  flex-shrink: 0;
}

.history-thumb-placeholder {
  width: 44px;
  height: 44px;
  border-radius: 6px;
  background: rgba(118,118,128,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tip-card {
  margin: 12px 16px 0;
  padding: 14px 16px;
  background: var(--ios-card);
  border-radius: var(--ios-radius);
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.tip-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.tip-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--ios-text);
}

.tip-desc {
  font-size: 13px;
  color: var(--ios-text-3);
  line-height: 1.5;
}

.subtitle {
  display: block;
  font-size: 15px;
  color: var(--ios-text-3);
  font-weight: 400;
  margin-top: 2px;
}

.index-logo {
  height: 40px;
  width: auto;
}

/* ===== AI 模型触发器 ===== */
.model-trigger {
  display: flex;
  align-items: center;
  margin: 12px 16px 0;
  padding: 10px 14px;
  background: rgba(118,118,128,0.12);
  border-radius: 10px;
  gap: 6px;
}

.model-trigger-text {
  font-size: 13px;
  color: var(--ios-text);
  font-weight: 500;
}

/* ===== AI 模型选择弹层 ===== */
.model-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0);
  z-index: 999;
  pointer-events: none;
  transition: background 0.25s;
}

.model-sheet-mask.mask-show {
  background: rgba(0,0,0,0.45);
  pointer-events: auto;
}

.model-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: var(--ios-card);
  border-radius: 16px 16px 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}

.model-sheet.sheet-show {
  transform: translateY(0);
}

.sheet-handle {
  width: 36px;
  height: 5px;
  background: rgba(118,118,128,0.3);
  border-radius: 3px;
  margin: 10px auto 0;
}

.sheet-header {
  text-align: center;
  font-size: 15px;
  font-weight: 600;
  color: var(--ios-text);
  padding: 16px 0 10px;
  border-bottom: 0.5px solid var(--ios-sep);
  margin: 0 16px;
}

.sheet-list {
  padding: 8px 0;
  max-height: 320px;
  overflow-y: auto;
}

.sheet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  transition: background 0.15s;
}

.sheet-item:active {
  background: rgba(118,118,128,0.08);
}

.sheet-item-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.sheet-item-name {
  font-size: 15px;
  color: var(--ios-text);
}

.sheet-item-active .sheet-item-name {
  color: #007AFF;
  font-weight: 600;
}

.sheet-cancel {
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  color: #007AFF;
  padding: 16px 0;
  border-top: 8px solid rgba(118,118,128,0.12);
  margin: 0 0;
}

.sheet-cancel:active {
  background: rgba(118,118,128,0.08);
}

